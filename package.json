{
  "name": "shoulderpain",
  "version": "1.0.0",
  "description": "Source-linked, static shoulder-pain and small-space workstation guide",
  "scripts": {
    "build": "python3 tools/claim_ledger.py && python3 tools/build.py",
    "check": "python3 tools/check.py",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "serve": "python3 -m http.server 8000 --bind 0.0.0.0",
    "format": "prettier --write \"content/*.html\" \"css/*.css\" \"js/*.js\" \"tests/**/*.cjs\" playwright.config.cjs",
    "format:check": "prettier --check \"content/*.html\" \"css/*.css\" \"js/*.js\" \"tests/**/*.cjs\" playwright.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buffedlizard55-lab/ShoulderPain.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/buffedlizard55-lab/ShoulderPain/issues"
  },
  "homepage": "https://github.com/buffedlizard55-lab/ShoulderPain#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.8"
  },
  "private": true
}
